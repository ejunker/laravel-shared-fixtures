parameters:
    level: 7
    paths:
        - src
        - tests
    excludePaths:
        # Pest DSL files use global test functions phpstan can't resolve without
        # a Pest extension; they carry no package logic worth analysing.
        - tests/ArchTest.php
        - tests/Pest.php
        - tests/Unit/FixtureTest.php
        # testbench dictates an untyped defineEnvironment($app) signature we
        # can't type natively; excluded so type-coverage stays deterministic.
        - tests/TestCase.php
        # declares the optional $freshFixtures property, which makes phpstan
        # narrow property_exists() in the trait to "always true" when analysed
        # in this class's context — a false positive. The trait stays analysed
        # via SharedFixturesTest (which doesn't declare it).
        - tests/Feature/FreshFixturesTest.php
    tmpDir: build/phpstan
